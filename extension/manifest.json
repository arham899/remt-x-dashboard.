{
    "manifest_version": 3,
    "name": "REMT-X Telemetry Extension",
    "version": "1.0.0",
    "description": "Real-time Telemetry & Live Mirroring for KoboToolbox and SurveyCTO.",
    "permissions": [
        "geolocation",
        "storage"
    ],
    "host_permissions": [
        "https://kf.kobotoolbox.org/*",
        "https://*.surveycto.com/*",
        "https://ee.kobotoolbox.org/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://kf.kobotoolbox.org/*",
                "https://*.surveycto.com/*",
                "https://ee.kobotoolbox.org/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_end"
        }
    ]
}